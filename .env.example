# ==============================================================================
# FinSight — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or production settings.
# NEVER commit your actual .env file or private credentials to GitHub.
# ==============================================================================

# --- Django Security ---
SECRET_KEY=replace-with-a-secure-random-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend URL ---
# Base URL where the React/Vite application runs (used for verification links)
FRONTEND_URL=http://localhost:5173

# --- Email Delivery Configuration ---
# For local development: outputs all verification and reset emails directly to terminal
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production delivery (uncomment and configure with your SMTP provider):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-account@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# DEFAULT_FROM_EMAIL=FinSight <noreply@finsight.local>
